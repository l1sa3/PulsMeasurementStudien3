<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>video_stream_opencv</name>
  <version>1.1.5</version>

  <description>
    The video_stream_opencv package publishes video streams supported by OpenCV 
    as ROS2 image topics, camera info and basic image flipping (horizontal, vertical or both) capabilities
    and also adjusting publishing rate.
  </description>

  <maintainer email="Sammy.Pfeiffer@student.uts.edu.au">Sammy Pfeiffer</maintainer>
  <author>Sammy Pfeiffer</author>

  <url type="website">http://www.ros.org/wiki/video_stream_opencv</url>
  <url type="development">https://github.com/ros-drivers/video_stream_opencv</url>
  <url type="bugtracker">https://github.com/ros-drivers/video_stream_opencv/issues</url>

  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>image_transport</depend>
  <depend>camera_info_manager</depend>
  <depend>pluginlib</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
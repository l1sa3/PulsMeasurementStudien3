<?xml version="1.0"?>
<launch>
    <arg name="input_topic" default="/my_camera/pylon_ros2_camera_node/image_raw" />
    <arg name="cascade_file" default="$(find-pkg-share common)/config/cascade.xml" />
    <arg name="show_image_frame" default="true" />
    <arg name="show_processed_image" default="false" />
    <include file="$(find-pkg-share pylon_camera)/launch/pylon_camera_node.launch" />
    <include file="$(find-pkg-share eulerian_motion_magnification)/launch/eulerian_motion_magnification.launch">
        <arg name="input_topic" value="$(var input_topic)" />
        <arg name="show_image_frame" value="$(var show_image_frame)" />
        <arg name="cascade_file" value="$(var cascade_file)" />
        <arg name="show_processed_image" value="$(var show_processed_image)" />
    </include>
</launch>
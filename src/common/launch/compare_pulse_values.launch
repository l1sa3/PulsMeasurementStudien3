<?xml version="1.0"?>
<launch>
    <arg name="topic" default="/pulse_chest_strap" />
    <arg name="topic_to_compare" default="/pulse_head_movement" />
    <arg name="video_file" default="" />
    <arg name="bdf_file" default="" />
    <node pkg="common" exec="compare_pulse_values.py" name="compare" output="screen">
        <param name="topic" value="$(var topic)" />
        <param name="topic_to_compare" value="$(var topic_to_compare)" />
    </node>
    <node name="pulse_plot" pkg="plotjuggler" exec="plotjuggler" args="--layout $(find-pkg-share common)/config/compare_config.xml"/>
    <group if="$(eval '\'$(var topic_to_compare)\' == \'/pulse_head_movement\'')">
        <group if="$(eval '\'$(var topic)\' == \'/pulse_chest_strap\'')">
            <!-- <include file="$(find pulse_head_movement)/launch/webcam.launch"/> -->
            <include file="$(find-pkg-share pulse_head_movement)/launch/industry_camera.launch"/>
            <node name="pulse_chest_strap" pkg="pulse_chest_strap" exec="pulse_chest_strap.py" args="-m 00:22:D0:84:1E:64" output="screen"/>
        </group>
        <group if="$(eval '$(var topic)' == '/ecg')">
            <include file="$(find-pkg-share pulse_head_movement)/launch/pulse_head_movement.launch">
                <arg name="video_file" value="$(var video_file)" />
                <arg name="bdf_file" value="$(var bdf_file)" />
            </include>
        </group>
    </group>
    <group if="$(eval '\'$(var topic_to_compare)\' == \'/eulerian_motion_magnification\'')">
        <group if="$(eval '\'$(var topic)\' == \'/pulse_chest_strap\'')">
            <!-- <include file="$(find eulerian_motion_magnification)/launch/webcam.launch"/> -->
            <include file="$(find-pkg-share eulerian_motion_magnification)/launch/industry_camera.launch"/>
            <node name="pulse_chest_strap" pkg="pulse_chest_strap" exec="pulse_chest_strap.py" args="-m 00:22:D0:84:1E:64" output="screen"/>
        </group>
        <group if="$(eval '\'$(var topic)\' == \'/ecg\'')">
            <include file="$(find-pkg-share eulerian_motion_magnification)/launch/eulerian_motion_magnification.launch">
                <arg name="video_file" value="$(var video_file)" />
                <arg name="bdf_file" value="$(var bdf_file)" />
            </include>
        </group>
    </group>
    <group if="$(eval '\'$(var topic_to_compare)\' == \'/legacy_measurement\'')">
        <group if="$(eval '\'$(var topic)\' == \'/pulse_chest_strap\'')">
            <include file="$(find-pkg-share legacy_measurement)/launch/webcam.launch"/>
            <node name="pulse_chest_strap" pkg="pulse_chest_strap" exec="pulse_chest_strap.py" args="-m 00:22:D0:84:1E:64" output="screen"/>
        </group>
        <group if="$(eval '\'$(var topic)\' == \'/ecg\'')">
            <include file="$(find-pkg-share legacy_measurement)/launch/legacy_measurement.launch">
                <arg name="video_file" value="$(var video_file)" />
                <arg name="bdf_file" value="$(var bdf_file)" />
            </include>
        </group>
    </group>
</launch>
<?xml version="1.0"?>
<launch>
    <arg name="input_topic" default="/webcam/image_raw" />
    <arg name="cascade_file" default="$(find-pkg-share common)/config/cascade.xml" />
    <arg name="show_image_frame" default="true" />
    <arg name="fps" default="30" />
    <arg name="show_plot" default="false"/>
    <include file="$(find-pkg-share video_stream_opencv)/launch/camera.launch" >
        <!-- node name and ros graph name -->
        <arg name="camera_name" value="webcam" />
        <!-- means video device 0, /dev/video0 -->
        <arg name="video_stream_provider" value="0)" />
        <!-- set camera fps to (if the device allows) -->
        <arg name="set_camera_fps" value="$(var fps)"/>
        <!-- set buffer queue size of frame capturing to (1 means we want the latest frame only) -->
        <arg name="buffer_queue_size" value="1" />
        <!-- throttling the querying of frames to -->
        <arg name="fps" value="$(var fps)" />
        <!-- setting frame_id -->
        <arg name="frame_id" value="webcam_optical_frame" />
        <!-- camera info loading, take care as it needs the "file:///" at the start , e.g.:
        "file:///$(find your_camera_package)/config/your_camera.yaml" -->
        <arg name="camera_info_url" value="" />
        <!-- flip the image horizontally (mirror it) -->
        <arg name="flip_horizontal" value="false" />
        <!-- flip the image vertically -->
        <arg name="flip_vertical" value="false" />
        <!-- visualize on an image_view window the stream generated -->
        <arg name="visualize" value="false" />
    </include>
    <include file="$(find-pkg-share legacy_measurement)/launch/legacy_measurement.launch">
        <arg name="input_topic" value="$(var input_topic)" />
        <arg name="show_image_frame" value="$(var show_image_frame)" />
        <arg name="cascade_file" value="$(var cascade_file)" />
    </include>
    <group if="$(var show_plot)">
        <node pkg="plotjuggler" exec="plotjuggler" name="pulse_plot" args="--layout $(find-pkg-share legacy_measurement)/config/plot_juggler_config.xml"/>
    </group>
</launch>
